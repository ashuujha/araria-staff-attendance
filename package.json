    "sharp": "^0.35.5",
    "tailwindcss": "4.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.58.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
