# Copy to .env.local for local development. Add the same names in Vercel Settings > Environment Variables.
# New Supabase API keys only. Never use the secret key in a NEXT_PUBLIC_* variable.
SUPABASE_URL=https://vkflommzumlrrzvwbdub.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Exact deployed HTTPS origin; used for CSRF protection and protected reporting links.
APP_URL=http://localhost:3000
# Generate: openssl rand -hex 32. Authenticates the sync scheduler.
CRON_SECRET=

# Staff/admin provisioning script only; do not expose through the browser.
INITIAL_ADMIN_EMAIL=sfc.aditya@gmail.com
INITIAL_ADMIN_PASSWORD=

# Optional until Google Sheets is connected. Private key may contain literal \n escapes.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Required before live uploads. HTTPS binary POST, bearer authentication, JSON {"clean":true}.
UPLOAD_SCAN_URL=
UPLOAD_SCAN_TOKEN=
