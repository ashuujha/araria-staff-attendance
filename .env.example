# Copy to .env.local for local development. Add the same names in Vercel Settings > Environment Variables.
# New Supabase API keys only. Never use the secret key in a NEXT_PUBLIC_* variable.
SUPABASE_URL=https://vkflommzumlrrzvwbdub.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Set true only AFTER enabling IP Address Forwarding in Supabase Auth > Rate Limits.
SUPABASE_AUTH_FORWARD_IP=false

# Exact deployed HTTPS origin; used for CSRF protection and protected reporting links.
APP_URL=http://localhost:3000

# Required for admin CAPTCHA. Create a free Managed Cloudflare Turnstile widget.
# Allow your deployed hostname and localhost if testing locally. Never use production test keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Generate: openssl rand -hex 32. Authenticates the sync scheduler.
CRON_SECRET=

# Staff/admin provisioning script only; do not expose through the browser.
INITIAL_ADMIN_EMAIL=sfc.aditya@gmail.com
INITIAL_ADMIN_PASSWORD=
# Quote password values containing # so the environment parser preserves them.

# Optional until Google Sheets is connected. Private key may contain literal \n escapes.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional external file scanner; both values required together. HTTPS binary POST, bearer auth, JSON {"clean":true}.
UPLOAD_SCAN_URL=
UPLOAD_SCAN_TOKEN=

# Optional Google Cloud translation of fixed UI labels; English works locally without a key.
GOOGLE_TRANSLATE_API_KEY=

# Optional trusted HTTPS overrides. Free GPS map/address defaults need no API key.
PHOTON_REVERSE_URL=https://photon.komoot.io/reverse
OSM_TILE_BASE_URL=https://tile.openstreetmap.org/
